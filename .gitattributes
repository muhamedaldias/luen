# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text file formats
*.ts text
*.tsx text
*.js text
*.mjs text
*.json text
*.md text
*.html text
*.css text
*.py text
*.toml text
*.yaml text
*.yml text

# Binary image formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.tiff binary

# Binary models & data
*.onnx binary
*.bin binary
*.pt binary
*.pth binary
*.safetensors binary
*.pkl binary
*.pickle binary

# Documents
*.pdf binary

# Archives & Executables
*.zip binary
*.tar.gz binary
*.exe binary
*.dll binary
*.so binary
*.wasm binary
